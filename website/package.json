{
  "name": "-gdg",
  "version": "0.0.0",
  "description": "GDG documentation site (Hugo + Relearn theme)",
  "author": "esnet",
  "license": "MIT",
  "scripts": {
    "dev": "bash scripts/hugo-dev-watch.sh --bind=0.0.0.0 --disableFastRender --baseURL=http://localhost/gdg/ --noHTTPCache",
    "dev:drafts": "bash scripts/hugo-dev-watch.sh --bind=0.0.0.0 --disableFastRender --baseURL=http://localhost/gdg/ --noHTTPCache --buildDrafts",
    "create": "hugo new",
    "lint": "npm run lint:markdown",
    "lint:markdown": "markdownlint-cli2 \"*.md\" \"content/**/*.md\"",
    "test": "echo \"Error: no test specified\" && exit 1",
    "build": "bash scripts/hugo-build.sh --minify",
    "preview": "http-server --gzip --brotli --ext=html --cors",
    "clean": "npm run clean:build && npm run clean:lint && npm run clean:install",
    "clean:build": "shx rm -rf public resources .hugo_build.lock",
    "clean:install": "shx rm -rf node_modules package-lock.json yarn.lock pnpm-lock.yaml",
    "clean:lint": "shx rm -rf .eslintcache .stylelintcache",
    "preinfo": "npm version",
    "info": "npm list",
    "postinfo": "hugo version"
  },
  "dependencies": {
    "pnpm": "^11.0.0",
    "hugo-extended": "0.166.0"
  },
  "devDependencies": {
    "shx": "^0.4.0"
  },
  "overrides": {
    "semver": "^7.5.4"
  },
  "engines": {
    "node": ">=18.14.1",
    "go": ">=1.21",
    "pnpm": ">=8.10.0"
  },
  "packageManager": "pnpm@11.28.0"
}
